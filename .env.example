# Your MENTA API key. Create it with `$apikey new my-bot` in Discord; it is
# DM'd to you once. Keep it on your server -- a key in front-end code is a
# published key.
MENTA_KEY=menta_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The signing secret from POST /v1/webhooks, if you receive webhooks.
MENTA_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only for examples/telegram-bot.js
TELEGRAM_TOKEN=123456:abcdef
